# Configuration locale — copier ce fichier en « .env » et l'adapter.
# Le fichier .env n'est jamais publié (voir .gitignore) : c'est lui qui porte
# les chemins et adresses propres à votre machine.

# Où sont stockées la base de données et les photos.
# Un disque externe fonctionne très bien : indiquer son point de montage.
DATA_PATH=./data

# Port d'écoute côté machine hôte.
#
# ⚠️ Éviter un port déjà utilisé par un autre service. Éviter aussi tout port
# qu'un outil de développement pourrait surveiller (3000 notamment) : certains
# panneaux de prévisualisation tuent le processus qui détient le port, ce qui
# met le conteneur en boucle de redémarrage.
HOST_PORT=3001

# Noms d'hôte autorisés à joindre l'application (protection anti-DNS-rebinding).
#
# Toutes les adresses IP privées sont acceptées d'office, ce qui couvre l'accès
# depuis le réseau local et depuis un tunnel VPN. N'ajouter ici que des noms de
# domaine, par exemple « regie.local ».
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Copies de sécurité périodiques de la base.
#
# Laisser vide pour les désactiver. Pour les activer, mettre /sauvegardes et
# faire pointer BACKUP_PATH vers un dossier situé sur un AUTRE disque que
# DATA_PATH — sinon la sauvegarde disparaîtrait avec l'original.
BACKUP_DIR=
BACKUP_PATH=./backups
